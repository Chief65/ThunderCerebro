<script>
(function () {
  var copyBtn = document.getElementById('tz-footer-copy-ip');
  var ipToCopy = 'thundermc.es';

  if (!copyBtn) return;

  copyBtn.addEventListener('click', function () {
    navigator.clipboard.writeText(ipToCopy).then(function () {
      copyBtn.classList.add('copied');
      copyBtn.textContent = '✓ Copiado';
      setTimeout(function () {
        copyBtn.classList.remove('copied');
        copyBtn.textContent = 'Copiar';
      }, 1800);
    }).catch(function () {
      var el = document.createElement('textarea');
      el.value = ipToCopy;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
    });
  });
})();
</script>

<script>
(function () {
  function hideTebexFooter() {
    document.querySelectorAll('tebex-footer').forEach(function (el) {
      el.style.setProperty('display', 'none', 'important');
      el.style.setProperty('visibility', 'hidden', 'important');
      el.style.setProperty('height', '0px', 'important');
      el.style.setProperty('max-height', '0px', 'important');
      el.style.setProperty('min-height', '0px', 'important');
      el.style.setProperty('overflow', 'hidden', 'important');
      el.style.setProperty('opacity', '0', 'important');
      el.style.setProperty('pointer-events', 'none', 'important');
      el.setAttribute('aria-hidden', 'true');
      try {
        if (el.shadowRoot) {
          var existing = el.shadowRoot.getElementById('tz-force-hide');
          if (!existing) {
            var style = document.createElement('style');
            style.id = 'tz-force-hide';
            style.textContent = ':host { display: none !important; height: 0 !important; min-height: 0 !important; visibility: hidden !important; }';
            el.shadowRoot.appendChild(style);
          }
        }
      } catch (e) {}
    });
  }

  hideTebexFooter();
  var observer = new MutationObserver(hideTebexFooter);
  observer.observe(document.documentElement, { childList: true, subtree: true });
  var attempts = 0;
  var interval = setInterval(function () {
    hideTebexFooter();
    attempts++;
    if (attempts > 20) clearInterval(interval);
  }, 500);
})();
</script>