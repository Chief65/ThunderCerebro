<input type="text" id="ipServer" value="{{ config("server-ip") }}">

<style>
  .tz-footer {
    background: hsl(220, 18%, 9%);
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 36px 24px 20px;
    width: 100%;
    margin-top: 60px;
  }

  .tz-footer__inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tz-footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
  }

  .tz-footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    min-width: 180px;
  }

  .tz-footer__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }

  /* Marca */
  .tz-footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tz-footer__brand img {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: block;
    object-fit: contain;
  }
  .tz-footer__brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tz-footer__brand-name {
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: .5px;
  }
  .tz-footer__brand-tag {
    font-size: 12px;
    color: rgba(255,255,255,0.4);
  }

  /* Copyright debajo del logo */
  .tz-footer__brand-copyright {
    font-size: 11px;
    color: rgba(255,255,255,0.25);
    line-height: 1.6;
    margin-top: 4px;
  }
  .tz-footer__brand-copyright p {
    margin: 0;
  }

  /* Bloque IP + puerto */
  .tz-footer__server-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tz-footer__server-ip {
    font-size: 13px;
    font-weight: 700;
    color: rgba(255,255,255,0.75);
  }
  .tz-footer__server-port {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
  }

  /* Botón copiar → solo texto, sin color */
  .tz-footer__copy-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-size: 11px;
    color: rgba(255,255,255,0.35);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .tz-footer__copy-btn:hover {
    color: rgba(255,255,255,0.7);
  }
  .tz-footer__copy-btn.copied {
    color: rgba(74, 222, 128, 0.7);
    text-decoration: none;
  }

  /* Soporte → solo texto interactivo */
  .tz-footer__support-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.15s;
    width: fit-content;
  }
  .tz-footer__support-link i {
    font-size: 15px;
    color: rgba(255,255,255,0.35);
  }
  .tz-footer__support-link:hover {
    color: rgba(255,255,255,0.9);
  }
  .tz-footer__support-link:hover i {
    color: rgba(255,255,255,0.6);
  }
  .tz-footer__support-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.35);
  }

  /* Redes sociales — sin cambios */
  .tz-footer__socials {
    display: flex;
    gap: 8px;
  }
  .tz-footer__socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    font-size: 15px;
    text-decoration: none;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .tz-footer__socials a:hover {
    color: #facc15;
    background: rgba(250,204,21,0.06);
    border-color: rgba(250,204,21,0.25);
  }

  /* Ocultar footer original de Tebex */
  tebex-footer {
    display: none !important;
  }

  /* Bloque legal Tebex — al final */
  .tz-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .tz-footer__legal-logo {
    flex-shrink: 0;
    padding-right: 8px;
  }
  .tz-footer__legal-logo svg path {
    fill: rgba(255,255,255,0.25);
  }
  .tz-footer__legal-text {
    flex: 1 1 280px;
    font-size: 11px;
    line-height: 1.5;
    color: rgba(255,255,255,0.35);
  }
  .tz-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    flex-shrink: 0;
  }
  .tz-footer__legal-links a {
    font-size: 11px;
    color: rgba(255,255,255,0.35);
    text-decoration: underline;
    transition: color 0.15s;
  }
  .tz-footer__legal-links a:hover { color: rgba(255,255,255,0.7); }

  .tz-footer__designed {
    margin-top: 8px;
  }
  .tz-footer__designed img {
    height: 18px;
    display: block;
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .tz-footer__designed:hover img { opacity: 1; }

  @media (max-width: 700px) {
    .tz-footer__top { flex-direction: column; gap: 20px; }
    .tz-footer__col { min-width: 0; }
    .tz-footer__legal-logo { display: none; }
  }
</style>

