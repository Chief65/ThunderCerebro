<!-- ══════════════════════════════════════════════════════════════════
     THUNDERMC SLIDE-OVER RIGHT CART DRAWER (BARRA LATERAL DERECHA)
     ══════════════════════════════════════════════════════════════════ -->
<style>
  /* Overlay oscuro con desenfoque de fondo */
  .tz-cart-drawer-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(5, 8, 15, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .tz-cart-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Contenedor Drawer deslizante desde la derecha */
  .tz-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 440px;
    height: 100vh;
    background: #090d16;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.7);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    overflow: hidden;
  }
  .tz-cart-drawer.is-active {
    transform: translateX(0);
  }

  /* ── HEADER DEL DRAWER ── */
  .tz-cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    background: #0d121f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
  }
  .tz-cart-user-side {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tz-cart-player-avatar {
    height: 52px;
    width: auto;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.6));
    flex-shrink: 0;
  }
  .tz-cart-user-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tz-cart-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.2px;
    margin: 0;
    line-height: 1.2;
  }
  .tz-cart-user-tag {
    font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tz-cart-user-tag .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
  }
  .tz-cart-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tz-cart-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
    transform: rotate(90deg);
  }

  /* ── CUERPO DEL DRAWER (LISTADO DE ITEMS) ── */
  .tz-cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }
  .tz-cart-summary-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .tz-cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tz-cart-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: #0d121f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 16px;
    box-sizing: border-box;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .tz-cart-item-card:hover {
    border-color: rgba(250, 204, 21, 0.3);
    transform: translateX(-2px);
  }
  .tz-cart-item-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .tz-cart-item-icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #facc15;
    font-size: 20px;
    flex-shrink: 0;
  }
  .tz-cart-item-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tz-cart-item-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tz-cart-item-meta {
    font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 12.5px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tz-cart-item-price {
    color: #facc15;
    font-weight: 800;
  }
  .tz-cart-item-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 18px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .tz-cart-item-remove:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  /* Estado carrito vacío */
  .tz-cart-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    gap: 14px;
  }
  .tz-cart-empty-icon {
    font-size: 54px;
    color: #334155;
    margin-bottom: 6px;
  }
  .tz-cart-empty-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }
  .tz-cart-empty-desc {
    font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 13.5px;
    color: #94a3b8;
    max-width: 260px;
    line-height: 1.5;
    margin: 0;
  }

  /* ── FOOTER DEL DRAWER (TOTAL Y CHECKOUT) ── */
  .tz-cart-drawer-footer {
    padding: 24px 28px;
    background: #0d121f;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }
  .tz-cart-total-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tz-cart-total-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .tz-cart-total-value {
    font-family: 'Plus Jakarta Sans', 'Montserrat', sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #facc15;
    letter-spacing: -0.5px;
  }
  .tz-cart-checkout-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px 20px;
    background: linear-gradient(135deg, #facc15 0%, #eab308 100%);
    border: none;
    border-radius: 12px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14.5px;
    font-weight: 800;
    color: #0b0f19;
    text-decoration: none !important;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(250, 204, 21, 0.35);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    overflow: hidden;
  }
  .tz-cart-checkout-btn::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 60%; height: 100%;
    background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.4) 50%, transparent 100%);
    transform: translateX(-170%) skewX(-20deg);
    will-change: transform;
    animation: tzBtnShineCart 3.5s infinite;
  }
  @keyframes tzBtnShineCart {
    0% { transform: translateX(-170%) skewX(-20deg); }
    30%, 100% { transform: translateX(270%) skewX(-20deg); }
  }
  .tz-cart-checkout-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(250, 204, 21, 0.5);
  }
  .tz-cart-checkout-btn i { font-size: 18px; }

  .tz-cart-secure-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 11.5px;
    color: #64748b;
    font-weight: 500;
  }
  .tz-cart-secure-badge i { color: #22c55e; font-size: 14px; }

  @media (max-width: 768px) {
    .tz-cart-drawer-overlay {
      z-index: 100000;
    }
    .tz-cart-drawer {
      z-index: 100001;
      max-width: 100vw;
      width: 100vw;
    }
    .tz-cart-drawer-header,
    .tz-cart-drawer-body,
    .tz-cart-drawer-footer {
      padding: 16px 18px;
    }
    .tz-cart-player-avatar {
      height: 44px;
    }
    .tz-cart-title {
      font-size: 16px;
    }
    .tz-cart-item-card {
      padding: 12px 14px;
      gap: 12px;
    }
  }
</style>

<!-- OVERLAY OSCURO -->
<div class="tz-cart-drawer-overlay" id="tzCartOverlay"></div>

<!-- DRAWER LATERAL DERECHO -->
<aside class="tz-cart-drawer" id="tzCartDrawer" aria-label="Carrito de compra">
  
  <!-- CABECERA -->
  <div class="tz-cart-drawer-header">
    <div class="tz-cart-user-side">
      {% if basket.ign %}
        {% set ignName = basket.ign %}
      {% else %}
        {% set ignName = "Invitado" %}
      {% endif %}
      <img class="tz-cart-player-avatar" src="https://minotar.net/bust/{{ ignName }}/64" onerror="this.src='https://minotar.net/avatar/{{ ignName }}/48'" alt="{{ ignName }}">
      <div class="tz-cart-user-info">
        <h3 class="tz-cart-title">{{ ignName }}</h3>
        <span class="tz-cart-user-tag"><span class="status-dot"></span> Carrito de Compras</span>
      </div>
    </div>
    <button class="tz-cart-close-btn" id="tzCartCloseBtn" aria-label="Cerrar carrito">
      <i class="mdi mdi-close"></i>
    </button>
  </div>

  <!-- LISTA DE PRODUCTOS -->
  <div class="tz-cart-drawer-body">
    <div class="tz-cart-summary-line">
      <span>Artículos Seleccionados</span>
      <span>{% if basket.packages %}{{ basket.packages|length }}{% else %}0{% endif %} Items</span>
    </div>

    {% if basket.packages and basket.packages|length > 0 %}
    <div class="tz-cart-items-list">
      {% for package in basket.packages %}
      <div class="tz-cart-item-card">
        <div class="tz-cart-item-main">
          <div class="tz-cart-item-icon">
            <i class="mdi mdi-cube-send"></i>
          </div>
          <div class="tz-cart-item-details">
            <span class="tz-cart-item-name">{{ package.name }}</span>
            <div class="tz-cart-item-meta">
              <span>Cant: {{ package.quantity }}</span>
              <span>•</span>
              <span class="tz-cart-item-price">{{ package.price|money }} {{ basket.currency }}</span>
            </div>
          </div>
        </div>
        <a href="/checkout/packages/remove/{{ package.id }}" class="tz-cart-item-remove" title="Eliminar del carrito">
          <i class="mdi mdi-trash-can-outline"></i>
        </a>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <!-- Estado Vacío -->
    <div class="tz-cart-empty-state">
      <i class="mdi mdi-cart-remove tz-cart-empty-icon"></i>
      <h4 class="tz-cart-empty-title">Tu carrito está vacío</h4>
      <p class="tz-cart-empty-desc">Explora el catálogo y añade rangos, llaves o paquetes a tu pedido.</p>
    </div>
    {% endif %}
  </div>

  <!-- FOOTER Y CHECKOUT -->
  <div class="tz-cart-drawer-footer">
    <div class="tz-cart-total-row">
      <span class="tz-cart-total-label">Total a Pagar</span>
      <span class="tz-cart-total-value">{{ basket.price|money }} {{ basket.currency }}</span>
    </div>
    
    {% if basket.ign %}
    <a href="/checkout/basket" class="tz-cart-checkout-btn">
      <i class="mdi mdi-lock-check"></i>
      <span>Continuar al Pago</span>
    </a>
    {% else %}
    <button type="button" class="tz-cart-checkout-btn" id="tzCartRequireLoginBtn">
      <i class="mdi mdi-account-arrow-right"></i>
      <span>Iniciar Sesión para Pagar</span>
    </button>
    {% endif %}

    <div class="tz-cart-secure-badge">
      <i class="mdi mdi-shield-check"></i>
      <span>Transacción cifrada SSL y entrega automática</span>
    </div>
  </div>

</aside>

<!-- SCRIPT DE CONTROL PARA APERTURA Y CIERRE DEL DRAWER -->
<script>
(function() {
  var overlay = document.getElementById('tzCartOverlay');
  var drawer = document.getElementById('tzCartDrawer');
  var closeBtn = document.getElementById('tzCartCloseBtn');
  var openBtn = document.getElementById('tzOpenCartBtn');

  function openDrawer() {
    if (overlay && drawer) {
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (overlay && drawer) {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

  // Listener nombrado para poder removerlo y evitar acumulación (memory leak)
  function tzCartEscapeHandler(e) {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('is-active')) {
      closeDrawer();
    }
  }
  // Remover antes de añadir para garantizar que no se duplica si el componente se re-monta
  document.removeEventListener('keydown', tzCartEscapeHandler);
  document.addEventListener('keydown', tzCartEscapeHandler);

  // Conectar botón de login forzado desde el drawer
  var requireLoginBtn = document.getElementById('tzCartRequireLoginBtn');
  if (requireLoginBtn) {
    requireLoginBtn.addEventListener('click', function() {
      closeDrawer();
      if (window.tzOpenLoginModal) {
        window.tzOpenLoginModal();
      }
    });
  }

  // Exportar globalmente para que botones de 'Añadir al carrito' puedan abrir el drawer
  window.tzOpenCartDrawer = openDrawer;
  window.tzCloseCartDrawer = closeDrawer;
})();

</script>