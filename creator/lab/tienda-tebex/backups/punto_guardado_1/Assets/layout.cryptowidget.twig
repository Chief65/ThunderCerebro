<button class="toggle__exchange">
    <svg xmlns="http://www.w3.org/2000/svg" width="2500" height="2500" viewBox="0.004 0 63.993 64"><path d="M63.04 39.741c-4.274 17.143-21.638 27.575-38.783 23.301C7.12 58.768-3.313 41.404.962 24.262 5.234 7.117 22.597-3.317 39.737.957c17.144 4.274 27.576 21.64 23.302 38.784z" fill="#f7931a"/><path d="M46.11 27.441c.636-4.258-2.606-6.547-7.039-8.074l1.438-5.768-3.512-.875-1.4 5.616c-.922-.23-1.87-.447-2.812-.662l1.41-5.653-3.509-.875-1.439 5.766c-.764-.174-1.514-.346-2.242-.527l.004-.018-4.842-1.209-.934 3.75s2.605.597 2.55.634c1.422.355 1.68 1.296 1.636 2.042l-1.638 6.571c.098.025.225.061.365.117l-.37-.092-2.297 9.205c-.174.432-.615 1.08-1.609.834.035.051-2.552-.637-2.552-.637l-1.743 4.02 4.57 1.139c.85.213 1.683.436 2.502.646l-1.453 5.835 3.507.875 1.44-5.772c.957.26 1.887.5 2.797.726L27.504 50.8l3.511.875 1.453-5.823c5.987 1.133 10.49.676 12.383-4.738 1.527-4.36-.075-6.875-3.225-8.516 2.294-.531 4.022-2.04 4.483-5.157zM38.087 38.69c-1.086 4.36-8.426 2.004-10.807 1.412l1.928-7.729c2.38.594 10.011 1.77 8.88 6.317zm1.085-11.312c-.99 3.966-7.1 1.951-9.083 1.457l1.748-7.01c1.983.494 8.367 1.416 7.335 5.553z" fill="#fff"/></svg>
</button>

<div class="crypto__widget">
    <iframe src="{{ config("cryptoWidgetURL") }}/iframe" class="crypto__exchange"></iframe>
</div>

<style>
.crypto__widget{z-index:9999;width:100%;height:100%;left:0;right:0;top:0;bottom:0;position:fixed;background:#000000b3;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;padding:20px;opacity:0;visibility:hidden;-webkit-transition:all .10s ease-in-out;transition:all .10s ease-in-out}.crypto__exchange{border:none;max-width:550px;width:100%;height:100%;-webkit-transform:translateY(-50%);transform:translateY(-50%);-webkit-transition:all .50s ease-in-out;transition:all .50s ease-in-out}.iframe__enabled{visibility:visible;opacity:1;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-animation:widget__open .10s ease-in-out;animation:widget__open .10s ease-in-out}.iframe__enabled .crypto__exchange{-webkit-transform:translateY(0);transform:translateY(0)}.iframe__disabled{opacity:0;visibility:hidden;-webkit-animation:widget__closed .10s ease-in-out;animation:widget__closed .10s ease-in-out}@-webkit-keyframes widget__open{0%{opacity:0}100%{opacity:1}}@keyframes widget__open{0%{opacity:0}100%{opacity:1}}@-webkit-keyframes widget__closed{0%{opacity:1}100%{opacity:0}}@keyframes widget__closed{0%{opacity:1}100%{opacity:0}}.toggle__exchange{display:block;position:fixed;z-index:10000;right:20px;bottom:20px;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;background:none;border:none;-webkit-box-shadow:none;box-shadow:none;outline:none;cursor:pointer}.toggle__exchange:hover svg{-webkit-transform:scale(1.05);transform:scale(1.05)}.toggle__exchange svg{width:50px;height:50px;-webkit-transition:all .2s ease-in-out;transition:all .2s ease-in-out}

</style>

<script>
    const toggleExchangeBtn = document.querySelector(".toggle__exchange")
    const exchangeIframe = document.querySelector(".crypto__widget")
    const cryptoWidget = document.querySelector(".crypto__exchange")
    let isIframeActive = false;

    const closeWidget = () => {
        isIframeActive = false
        exchangeIframe.classList.remove("iframe__enabled")
    }

    const toggleWidget = () => {
        exchangeIframe.classList.add("iframe__enabled")
        isIframeActive = true
    }

    const handleWidget = () => {
        if (isIframeActive) {
            closeWidget()
            return;
        }
        toggleWidget()
    }

    toggleExchangeBtn.addEventListener("click", () => {
        handleWidget()
    })

    // Check if is clicking outside the iframe.
    exchangeIframe.addEventListener("click", (e) => {
        let isClickInsideElement = exchangeIframe.contains(e.target);

        if (isClickInsideElement)
            closeWidget()
    })
</script>