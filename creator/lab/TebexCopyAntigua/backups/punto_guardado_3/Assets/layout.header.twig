<div class="tz-header-spacer"></div>

<script>
(function () {
  var slide1 = document.getElementById('tzSlide1');
  var slide2 = document.getElementById('tzSlide2');
  var currentIdx = 0;
  var slides = [slide1, slide2];

  setInterval(function () {
    if (!slides[0] || !slides[1]) return;

    var current = slides[currentIdx];
    var nextIdx = (currentIdx + 1) % slides.length;
    var next = slides[nextIdx];

    // Preparar el siguiente para entrar por arriba
    next.style.transition = 'none';
    next.className = 'tz-announcement-slide';
    void next.offsetWidth; // Forzar reflow

    // Reactivar transiciones y ejecutar slide vertical hacia abajo
    next.style.transition = '';
    current.className = 'tz-announcement-slide is-leaving';
    next.className = 'tz-announcement-slide is-current';

    currentIdx = nextIdx;
  }, 4000);

  // Live Countdown
  var countdownEl = document.getElementById('tzCountdownDisplay');
  var targetDate = new Date();
  targetDate.setDate(targetDate.getDate() + 2);
  targetDate.setHours(targetDate.getHours() + 14);
  function updateCountdown() {
    var now = new Date().getTime();
    var diff = targetDate.getTime() - now;
    if (diff <= 0) { if (countdownEl) countdownEl.innerText = '00d 00h 00m 00s'; return; }
    var d = Math.floor(diff / (1000 * 60 * 60 * 24));
    var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    var s = Math.floor((diff % (1000 * 60)) / 1000);
    function p(n) { return (n < 10 ? '0' : '') + n; }
    if (countdownEl) countdownEl.innerText = p(d)+'d '+p(h)+'h '+p(m)+'m '+p(s)+'s';
  }
  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Smart Sticky Header: Ocultar al bajar, mostrar al subir
  var headerEl = document.getElementById('tz-main-header');
  if (headerEl) {
    var lastScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
    var scrollThreshold = 10;

    window.addEventListener('scroll', function() {
      var currentScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;

      // Si estamos muy arriba (en la cabecera del documento), mantenerlo visible
      if (currentScrollY <= 80) {
        headerEl.classList.remove('is-hidden');
        lastScrollY = currentScrollY;
        return;
      }

      // Detectar dirección
      if (Math.abs(currentScrollY - lastScrollY) > scrollThreshold) {
        if (currentScrollY > lastScrollY) {
          // Bajando -> ocultar
          headerEl.classList.add('is-hidden');
        } else {
          // Subiendo -> mostrar
          headerEl.classList.remove('is-hidden');
        }
        lastScrollY = currentScrollY;
      }
    }, { passive: true });
  }
})();
</script>
