{% set quantityCategoryType = '' %}
{% if theme_configuration.quantityAddonConfiguration.enabled %}
    {% for key, categoryData in theme_configuration.quantityAddonConfiguration.categories %}
        {% if category.id == categoryData.id %}
            {% set quantityCategoryType = categoryData.type %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if basket.currency == 'USD' %}
    {% set currencySymbol = '$' %}
    {% set currencyAfter = false %}
{% elseif basket.currency == 'EUR' %}
    {% set currencySymbol = '€' %}
    {% set currencyAfter = true %}
{% elseif basket.currency == 'GBP' %}
    {% set currencySymbol = '£' %}
    {% set currencyAfter = false %}
{% else %}
    {% set currencySymbol = basket.currency %}
    {% set currencyAfter = true %}
{% endif %}

<style>
  #tz-qty-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(240px, 280px)) !important;
    gap: 20px !important;
    padding: 8px 0 !important;
    justify-content: center !important;
  }
  #tz-qty-grid .tz-card {
    background: hsl(220, 18%, 10%) !important;
    border: 1px solid hsl(220, 16%, 20%) !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    cursor: pointer !important;
    position: relative !important;
    display: block !important;
  }
  #tz-qty-grid .tz-card .tz-img-wrap {
    width: 100% !important;
    aspect-ratio: 1/1 !important;
    overflow: hidden !important;
    background: #facc15 !important;
    padding: 16px !important;
    box-sizing: border-box !important;
    position: relative !important;
    display: block !important;
  }
  #tz-qty-grid .tz-card .tz-img-wrap img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    border: 0 !important;
    display: block !important;
  }
  #tz-qty-grid .tz-card .tz-info {
    padding: 12px 14px 14px 14px !important;
  }
  #tz-qty-grid .tz-card .tz-name {
    margin: 0 0 10px 0 !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    line-height: 1.3 !important;
  }
  #tz-qty-grid .tz-card .tz-price-spacer {
    margin-bottom: 10px !important;
    min-height: 44px !important;
  }
  #tz-qty-grid .tz-card .tz-qty-label {
    margin: 0 0 8px 0 !important;
    font-size: 11px !important;
    color: rgba(255,255,255,0.3) !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
  }
  #tz-qty-grid .tz-card .tz-btns {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px !important;
  }
  #tz-qty-grid .tz-card .tz-btns a {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #facc15 !important;
    color: #111827 !important;
    border-radius: 6px !important;
    padding: 7px 14px !important;
    text-decoration: none !important;
    font-size: 13px !important;
    font-weight: 800 !important;
  }
</style>

<div id="tz-qty-grid"></div>

<script>
    function groupProductsByCategory(e){let t={};for(let[r,a]of Object.entries(e)){let u=a.name.replace(/ *\| */g,""),o=u.replace(/\d+[xX]\d*|\d*\s*[xX]\d+/g,"").trim(),l=u.match(/\d+[xX]\d*|\d*\s*[xX]\d+/);t[o]=t[o]||{name:o,image:a.image,products:{}};let n={...a,name:u.replace(/\d+[xX]\d*|\d*\s*[xX]\d+/g,"").trim()};l&&(n.quantity=parseInt(l[0].replace(/[xX]/,""),10)),t[o].products[r]=n}return Object.values(t)}function groupProductsByNumericValue(e){let t={};for(let[,r]of Object.entries(e)){let a=r.name.match(/(\d+)/),u=a?parseInt(a[1]):null,o=r.name.replace(/\d+/g,"").trim();t[o]=t[o]||{name:o,image:r.image,products:{}},t[o].products[r.id]={...r,name:o,quantity:u}}for(let[,l]of Object.entries(t))l.products=Object.values(l.products).sort((e,t)=>e.quantity-t.quantity);return Object.values(t)}function groupProductsByFilter(e,t){let r={};for(let a of e){let{name:u}=a;for(let o of t)if(u.includes(o)){let l=o.trim();r.hasOwnProperty(l)||(r[l]={name:l,image:a.image,products:[]}),r[l].products.push({...a,name:u.replace(l,"").trim(),quantity:u.replace(l,"").trim()});break}}return Object.values(r)}

    const qtyGrid = document.querySelector('#tz-qty-grid');
    const products = [];

    {% for product in category.packages %}
    {% set packageLink = '' %}
    {% if product.basket %}
        {% set packageLink = "/checkout/packages/remove/" ~ product.id %}
    {% else %}
        {% if product.type != "single" %}{% set packageLink = "/checkout/packages/add/" ~ product.id ~ "/subscribe" %}{% endif %}
        {% if product.type != "subscription" %}{% set packageLink = "/checkout/packages/add/" ~ product.id ~ "/single" %}{% endif %}
    {% endif %}
    products.push({
        name: "{{ product.name }}",
        image: "{{ product.image.url }}",
        id: "{{ product.id }}",
        isInCart: {{ product.basket ? 'true' : 'false' }},
        href: "{{ packageLink }}"
    });
    {% endfor %}

    {% if quantityCategoryType == 'x' %}const groupedProducts = groupProductsByCategory(products);{% endif %}
    {% if quantityCategoryType == 'numeric' %}const groupedProducts = groupProductsByNumericValue(products);{% endif %}
    {% if quantityCategoryType == 'filter' %}
    const groupedProducts = groupProductsByFilter(products, [
        {% for key, categoryData in theme_configuration.quantityAddonConfiguration.categories %}
        {% if category.id == categoryData.id %}
        {% for key, filter in categoryData.filters %}"{{ filter }}"{%- if not loop.last -%},{%- endif %}{% endfor %}
        {% endif %}{% endfor %}
    ]);
    {% endif %}

    for (const [, cat] of Object.entries(groupedProducts)) {
        const firstProduct = Object.values(cat.products)[0];

        let quantityBtns = '';
        for (const [, product] of Object.entries(cat.products)) {
            quantityBtns += `<a href="javascript:void(0);" data-remote="/package/${product.id}" class="triplezone__toogle--modal">x${product.quantity}</a>`;
        }

        qtyGrid.insertAdjacentHTML('beforeend', `
            <div class="tz-card">
                <a href="javascript:void(0);" data-remote="/package/${firstProduct.id}" class="triplezone__toogle--modal tz-img-wrap">
                    <img src="${cat.image}" alt="${cat.name}">
                </a>
                <div class="tz-info">
                    <p class="tz-name">${cat.name}</p>
                    <div class="tz-price-spacer"></div>
                    <p class="tz-qty-label">Elige una cantidad</p>
                    <div class="tz-btns">${quantityBtns}</div>
                </div>
            </div>
        `);
    }
</script>