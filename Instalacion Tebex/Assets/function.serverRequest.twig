const serverId = "337671";

{% if config('serverType') != 'FiveM' %}
$(document).ready(function () {
    $(".minecraft-widget").click(function () {
        if (typeof swal === 'function') {
            swal({
                title: "{{ config('server-ip') }}",
                text: "{{ lang.join_text }}",
                button: "OK",
                timer: 5000,
            });
        }
        var ipEl = document.getElementById("ipServer");
        if (ipEl) {
            ipEl.select();
            document.execCommand("copy");
        }
    });
});
{% endif %}

const fetchData = async (url) => {
    try {
        if (typeof axios === 'undefined') return null;
        const response = await axios.get(url);
        return response.data;
    } catch (error) {
        return null;
    }
};

const getDiscordCount = async () => {
    const discordId = "{{ config('discord_id') }}".trim();
    if (!discordId) return 0;
    const data = await fetchData(`https://discordapp.com/api/guilds/${discordId}/embed.json`);
    return data ? (data.presence_count || 0) : 0;
};

const getFivemCount = async () => {
    const cfxURL = "{{ config('fivem-cfx-link') }}".trim();
    if (!cfxURL) return 0;
    const serverId = cfxURL.split("/").pop();
    const data = await fetchData(`https://servers-frontend.fivem.net/api/servers/single/${serverId}`);
    return data && data.Data ? data.Data.clients : 0;
};

const getMinetoolsCount = async () => {
    const ip = "{{ config('server-ip') }}".trim();
    if (!ip) return 0;
    const port = "{{ config('server-port') }}".trim() || "25565";
    const data = await fetchData(`https://api.minetools.eu/ping/${ip}/${port}`);
    return data && data.players ? data.players.online : 0;
};

const getRustServersCount = async () => {
    const port = "{{ config('server-port') }}".trim();
    if (!port) return 0;
    const data = await fetchData(`https://api.rust-servers.info/status/${port}`);
    return data ? data.players : 0;
};

const getGamingServerCount = async () => {
    switch ("{{ config('serverType') }}") {
        case "Discord":
            return getDiscordCount();
        case "FiveM":
            return getFivemCount();
        case "Minecraft":
            return getMinetoolsCount();
        case "Rust":
            return getRustServersCount();
        default:
            return 0;
    }
};

const setPlayersData = async () => {
    try {
        const discordCounter = await getDiscordCount();
        const serverCounter = await getGamingServerCount();

        const discordCountElement = document.getElementById("discord-count");
        if (discordCountElement && discordCounter >= 0) {
            discordCountElement.innerHTML = typeof numberWithCommas === 'function' ? numberWithCommas(discordCounter) : discordCounter;
        }

        const serverCountElement = document.querySelector(".player-count");
        if (serverCountElement && serverCounter != null) {
            serverCountElement.innerHTML = typeof numberWithCommas === 'function' ? numberWithCommas(serverCounter) : serverCounter;
        }
    } catch (e) {
        // Ignorar de forma segura si no existen elementos en esta vista
    }
};

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setPlayersData);
} else {
    setPlayersData();
}