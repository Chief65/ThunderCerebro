            --disable-button: #15803d;
            --font-family: 'Poppins', 'Be Vietnam Pro', sans-serif;
            --heading-font: 'Bakbak One', 'Poppins', sans-serif;
            --tiny-font: 12px;
            --small-font: 14px;
            --medium-font: 16px;
            --big-font: 18px;
            --border-radius: 14px;
            --header-img: url({{ config("background-image") }});
            --filter-shadow: rgba(250, 204, 21, 0.25);
            --gradient-shadow: rgba(250, 204, 21, 0.25);
            --height-image: 530px;
            --opacity-image: 0.25;
