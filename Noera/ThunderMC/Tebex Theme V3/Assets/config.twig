{% extends 'languageConfig.twig' %}

{% set colors %}
    <style>
        :root {
            --price-normal: #f1f5f9;
            --price-sale: #ff2d2d;
            --price-original: #64748b;
            --logo_width: 400px;
            --main-color: #facc15;
            --error-color: #f87171;
            --hover-buy: #4ade80;
            --hover-sell: #f87171;
            --hover-info: #38bdf8;
