        .triplezone-modules {
            display: none !important;
            margin: 0;
        }
        .triplezone-module {
            margin: 0 !important;
            flex: auto !important;
            margin-bottom: 20px !important;
        }
        .body--with-sidebar {
            margin-top: 20px !important;
        }
        @media only screen and (min-width: 968px) {
            .sidebar-header, .sidebar-nav {
                display: none !important;
            }
            .triplezone__second--nav {
                display: block !important;
            }
            .triplezone-modules {
                display: flex !important;
            }
        }
        {% if config("topbar_style") == "centered" %}
        .second__nav--list {
