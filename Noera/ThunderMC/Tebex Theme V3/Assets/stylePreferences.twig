<style>
    {% for category in store.categories %}
    [data-category-image="{{ category.id }}"]:before {
        background: url("{{ config("icon-#{category.id}") }}") no-repeat center !important;
        background-size: contain !important;
    }
    {% endfor %}
    {% for page in store.pages %}
    [data-category-image="{{ page.slug|escape }}"]:before {
        background: url("{{ config("icon-#{page.slug}") }}") no-repeat center !important;
        background-size: contain !important;
    }
    {% endfor %}
</style>


{% if config("category_navigation") == "topbar" or config("category_navigation") == "modal" %}
